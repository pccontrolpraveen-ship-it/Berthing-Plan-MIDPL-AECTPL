# ── Secrets — never commit ────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ── Dependencies & build output ───────────────────────────
node_modules/
dist/
build/
.next/
out/
*.tsbuildinfo

# ── Test artefacts ────────────────────────────────────────
shots/
test-results/
playwright-report/
coverage/

# ── Operational data (commercially sensitive) ─────────────
# Vessel schedules, line/agent documents and exports do not belong in Git
*.xlsx
*.xls
*.csv
!docs/**/*.csv
data/
exports/

# ── Editor & OS noise ─────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# ── Native mobile build output (Capacitor) ────────────────
# The android/ and ios/ projects ARE committed — they hold native configuration
# you edit. Only their build output and the web payload cap sync regenerates are
# ignored; each platform's own .gitignore covers the rest.
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/.gradle/
android/local.properties
ios/App/App/public/
ios/App/Pods/
ios/App/output/
