<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron requires both under the hardened runtime: its JavaScript engine
       allocates executable memory, which is otherwise refused. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The app talks to its own persistence API over the loopback interface and,
       when configured, to a PostgreSQL host. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- The bundled API listens on 127.0.0.1. -->
  <key>com.apple.security.network.server</key>
  <true/>
</dict>
</plist>
